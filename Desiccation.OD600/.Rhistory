data$Dilution <- factor(data$Dilution)
data$Strain <- factor(data$Strain)
km.fit <- survfit(Surv(Time, Event) ~ Strain + Dilution, data = data)
km.fit <- survfit(Surv(Time, Event) ~ interaction(Strain, Dilution), data = data)
plot(km.fit, col = 1:8, lty = 1:8,
xlab = "Time (h)",
ylab = "Survival probability")
legend("bottomleft",
legend = levels(interaction(data$Strain, data$Dilution)),
col = 1:8, lty = 1:8)
for(d in levels(data$Dilution)){
fit <- survfit(Surv(Time, Event) ~ Strain,
data = subset(data, Dilution == d))
plot(fit,
main = paste("Dilution", d),
col = c("blue","red"),
lwd = 2,
xlab = "Time (h)",
ylab = "Survival")
legend("bottomleft",
legend = levels(data$Strain),
col = c("blue","red"),
lwd = 2)
}
par(mar = c(5, 7, 5, 7))
plot(datasurv.fit, conf.int = TRUE, mark.time = FALSE,
xlim = c(0,48), ylim = c(0,1),
lty = c(1,3,3,1,3,3),
col = c("black", "grey"),
xlab = "Time (d)",
ylab = "", cex.lab = 1.5, cex.axis = 1.2, las = 1, lwd = 2,
yaxt = "n", xaxt = "n")
box(lwd=2)
mtext("Survivorship", side = 2, outer = TRUE, cex = 1.5, line = -3, adj = 0.5)
axis(side = 2, labels = T, lwd.ticks = 2, las = 1, cex.axis = 1.25,  #Y axis
at = c(0, 0.25, 0.5, 0.75, 1.0))
axis(side = 4, labels = F, lwd.ticks = 2,   #Right
at = c(0, 0.25, 0.5, 0.75, 1.0))
axis(side = 1, labels = T, lwd.ticks = 2, las = 1, cex.axis = 1.25,  #x axis
at = c(24, 48))
axis(side = 3, labels = F, lwd.ticks = 2, las = 1, cex.axis = 1.25,   #Left
at = c(0, 10, 20, 30, 40, 50))
legend("bottomleft", legend = levels(data$Strain),
col = c("black", "grey"), lwd = 2)
