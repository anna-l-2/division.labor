cfu <- function(colony, dilution, volume){
DF <- 10^(-dilution)
(colony * DF) / volume
}
cfu(data)
cfu(colony = 770, dilution = -5, volume = 0.1)
data <- data %>%
mutate(CFU = cfu(Count, Dilution, 0.1))
