data
mean_data
mean_data <- data %>%
group_by(Time, Type) %>%
summarise(
mean_CFU = mean(CFU, na.rm = TRUE),
mean_ph  = mean(ph, na.rm = TRUE),
.groups = "drop"
)
mean_data
mean_data<- rename(mean_data,
CFU = mean_CFU,
ph = mean_ph)
mean_data
data.aov <-aov(CFU~Time*Type, mean_data)
summary(data.aov)
data.aov
data.aov <-aov(CFU~Time*Type, data)
summary(data.aov)
