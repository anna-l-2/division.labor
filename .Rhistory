library(tidyr)
library(ggplot2)
library(stringr)
library(dplyr)
library(tidyverse)
library(ggpubr)
library(deSolve)
theme_set(theme_classic() +
theme(axis.title = element_text(size = 16),
axis.title.x = element_text(margin = margin(t = 15, b = 15)),
axis.title.y = element_text(margin = margin(l = 15, r = 15)),
axis.text = element_text(size = 13),
axis.text.x = element_text(margin = margin(t = 5)),
axis.text.y = element_text(margin = margin(r = 5)),
#axis.line.x = element_line(linewidth = 1),
#axis.line.y = element_line(linewidth = 1),
axis.line.x = element_blank(),
axis.line.y = element_blank(),
axis.ticks.x = element_line(linewidth = 1),
axis.ticks.y = element_line(linewidth = 1),
axis.ticks.length = unit(.1, "in"),
panel.border = element_rect(color = "grey20", fill = NA, linewidth = 1.5),
legend.text = element_text(size = 14),
strip.text = element_text(size = 14),
strip.background = element_blank()
))
model <- function(t, state, parms) {
with(as.list(c(state, parms)), {
# Functional responses
f1a <- mu1a_max * Ra / (K1a + Ra)
f1b <- mu1b_max * Rb / (K1b + Rb)
f2a <- mu2a_max * Ra / (K2a + Ra)
f2b <- mu2b_max * Rb / (K2b + Rb)
# Population dynamics
dC1 <- C1 * ((1 - l1a) * f1a + (1 - l1b) * f1b - sigma1 + theta1)
dC2 <- C2 * ((1 - l2a) * f2a + (1 - l2b) * f2b - sigma2 + theta2)
# Resource dynamics
# These are written in a standard consistent way:
# resource a is consumed by both consumers on resource a
# resource b is consumed by both consumers on resource b
dRa <- C1 * (l1a * f1a + l1b * f1b) -
(C1 * mu1a_max * Ra / (K1a + Ra) +
C2 * mu2a_max * Ra / (K2a + Ra))
dRb <- C1 * (l2a * f2a + l2b * f2b) -
(C1 * mu1b_max * Rb / (K1b + Rb) +
C2 * mu2b_max * Rb / (K2b + Rb))
list(c(dC1, dC2, dRa, dRb))
})
}
# Example parameter values (replace with yours)
parms <- c(
l1a = 0.2, l1b = 0.3,
l2a = 0.25, l2b = 0.15,
mu1a_max = 1.0, mu1b_max = 0.9,
mu2a_max = 0.8, mu2b_max = 1.1,
K1a = 0.5, K1b = 0.6,
K2a = 0.4, K2b = 0.7,
sigma1 = 0.2, sigma2 = 0.25,
theta1 = 0.05, theta2 = 0.04
)
# Initial conditions
state <- c(
C1 = 0.5,
C2 = 0.5,
Ra = 10,
Rb = 10
)
# Time grid
times <- seq(0, 200, by = 0.1)
# Run simulation
out <- ode(y = state, times = times, func = model, parms = parms, method = "lsoda")
out <- as.data.frame(out)
# Plot
matplot(out$time, out[, c("C1", "C2", "Ra", "Rb")],
type = "l", lty = 1, xlab = "Time", ylab = "State")
legend("topright", legend = c("C1", "C2", "Ra", "Rb"),
lty = 1, col = 1:4, bty = "n")
model <- function(t, state, parms) {
with(as.list(c(state, parms)), {
# Functional responses
f1a <- mu1a_max * Ra / (K1a + Ra)
f1b <- mu1b_max * Rb / (K1b + Rb)
f2a <- mu2a_max * Ra / (K2a + Ra)
f2b <- mu2b_max * Rb / (K2b + Rb)
# Population dynamics
dC1 <- C1 * ((1 - l1a) * f1a + (1 - l1b) * f1b - sigma1 + theta1)
dC2 <- C2 * ((1 - l2a) * f2a + (1 - l2b) * f2b - sigma2 + theta2)
# Resource dynamics
# These are written in a standard consistent way:
# resource a is consumed by both consumers on resource a
# resource b is consumed by both consumers on resource b
dRa <- C1 * (l1a * f1a + l1b * f1b) -
(C1 * mu1a_max * Ra / (K1a + Ra) +
C2 * mu2a_max * Ra / (K2a + Ra))
dRb <- C1 * (l2a * f2a + l2b * f2b) -
(C1 * mu1b_max * Rb / (K1b + Rb) +
C2 * mu2b_max * Rb / (K2b + Rb))
list(c(dC1, dC2, dRa, dRb))
})
}
# Example parameter values (replace with yours)
