setwd("C:/Users/ajl21/github/division.labor/prelim_coexistence/")
A.1L1 <-  read_excel("20260720_1708_Kost_prelimco_ind.xlsx", sheet = ".1A1L")
A1L.1 <-  read_excel("20260720_1708_Kost_prelimco_ind.xlsx", sheet = "1A.1L")
AL <-  read_excel("20260720_1708_Kost_prelimco_ind.xlsx", sheet = "AL")
long <- function(data, culture) {
data |>
pivot_longer(
cols = everything(),
names_to = "Day",
values_to = "OD"
) |>
dplyr::mutate(Culture = culture)
}
A.1L1 <-  long(A.1L1, ".1Arg+1Lys")
A1L.1 <-  long(A1L.1, "1Arg+.1Lys")
AL <- long(AL, "1Arg+1Lys")
combined<- rbind(A.1L1,A1L.1,AL)
combined$Day <- factor(combined$Day,
levels = c("2", "4", "6",  "8"))
combined <- combined %>%
group_by(Culture) %>%
mutate(Replicate = rep(1:3, each = n() / 3)) %>%
ungroup()
ggplot(combined, aes(x = Day, y = OD, group = Culture)) +geom_point()+
geom_smooth() +
facet_wrap(~ Culture, ncol = 3) +
labs(x = "Day", y = "OD600", color = "Culture") +
scale_y_continuous(breaks = seq(0, 2, by = 0.5)) +
theme_minimal(base_size = 12) +
theme(
axis.text.x = element_text(angle = 45, vjust = 1, hjust = 1),
strip.text = element_text(face = "bold"),
legend.position = "bottom"
)
#Stability
coefvar.in <- combined %>%
group_by(Culture, Day) %>%
summarise(
Mean = mean(OD, na.rm = TRUE),
SD = sd(OD, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(CV = Mean / SD)
ggplot(coefvar.in, aes(x=Day, y=CV, group = Culture)) +geom_point()+ geom_smooth(se=FALSE)+labs(y= "Stability")+ theme(axis.text.x = element_text(angle = 65, vjust = 1, hjust = 1)) +facet_wrap(~ Culture, ncol = 3)
#Temporal Variability
daily.means <- combined %>%
group_by(Culture, Replicate) %>%
summarise(
Mean.OD = mean(OD, na.rm = TRUE),
.groups = "drop"
)
temporal.stability <- daily.means %>%
group_by(Culture, Replicate) %>%
summarise(
Mean = mean(Mean.OD),
SD = sd(Mean.OD),
Stability = Mean / SD,
Temporal.Variability = SD / Mean,
.groups = "drop")
temp.table<-temporal.stability %>%
flextable() %>%
colformat_double(digits = 3) %>%
set_header_labels(
Mean = "Mean OD",
Stability = "Stability (Mean/SD)",
Temporal.Variability = "Temporal Variability",
Replicate = "Replicate"
) %>%
autofit()
ggplot(temporal.stability, aes(x=Culture, y=Stability, group = Culture)) +geom_boxplot()+ geom_point()+ labs(y= "Stability", color = "Type")+ theme(axis.text.x = element_text(angle = 65, vjust = 1, hjust = 1))
# ggplot(temporal.stability, aes(x=Culture, y=Temporal.Variability, group = Culture)) +geom_boxplot()+ geom_point()+ labs(y= "Temporal Variability", color = "Type")+ theme(axis.text.x = element_text(angle = 65, vjust = 1, hjust = 1))
