# ANOVA
mod <- aov(Stability ~ Culture, data = temporal.stability)
# Tukey HSD
tukey <- TukeyHSD(mod)
# Compact letter display
letter_list <- multcompLetters4(mod, tukey)
letter_df <- data.frame(
Culture = names(letter_list$Culture$Letters),
Letters = letter_list$Culture$Letters
)
# Position letters above each box
letter_df <- letter_df %>%
left_join(
temporal.stability %>%
group_by(Culture) %>%
summarise(
ymax = max(Stability, na.rm = TRUE),
.groups = "drop"
),
by = "Culture"
) %>%
mutate(y = ymax + 0.08)
# Plot
ggplot(
temporal.stability,
aes(x = Culture, y = Stability, group = Culture)
) +
geom_boxplot() +
geom_point() +
geom_text(
data = letter_df,
aes(x = Culture, y = y, label = Letters),
inherit.aes = FALSE,
size = 5
) +
labs(
x = "Culture",
y = "Stability"
) +
theme(
axis.text.x = element_text(
angle = 65,
vjust = 1,
hjust = 1
)
)
